rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserDoc().role
        : 'contributor';
    }

    function isReviewerOrHigher() {
      return isAuthenticated() && getUserRole() in [
        'reviewer', 'senior_reviewer', 'linguistic_advisor', 'administrator', 'project_director',
        'Reviewer', 'Senior Reviewer', 'Linguistic Advisor', 'Administrator', 'Project Director'
      ];
    }

    function isSeniorLinguistOrDirector() {
      return isAuthenticated() && getUserRole() in [
        'senior_reviewer', 'linguistic_advisor', 'administrator', 'project_director',
        'Senior Reviewer', 'Linguistic Advisor', 'Administrator', 'Project Director'
      ];
    }

    function isAdminOrDirector() {
      return isAuthenticated() && getUserRole() in [
        'administrator', 'project_director', 'Administrator', 'Project Director'
      ];
    }

    function isLinguistAdminOrDirector() {
      return isAuthenticated() && getUserRole() in [
        'linguistic_advisor', 'administrator', 'project_director',
        'Linguistic Advisor', 'Administrator', 'Project Director'
      ];
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdminOrDirector());
      allow create: if isAuthenticated() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role in ['Contributor', 'contributor'];
      allow update: if isAuthenticated() && (
        (request.auth.uid == uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'uid', 'email', 'createdAt', 'reputationScore', 'rewardsEarned', 'calculatedRewardPkr'
         ])) ||
        isAdminOrDirector()
      );
      allow delete: if isAdminOrDirector();

      match /consents/{consentId} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || isAdminOrDirector());
        allow create: if isAuthenticated() && request.auth.uid == uid &&
          request.resource.data.userUid == uid && request.resource.data.consentId == consentId;
        allow update, delete: if false;
      }
    }

    match /contributions/{contributionId} {
      allow read: if (resource.data.status in ['approved', 'corrected', 'verified_canonical'] &&
                     (!('isRestricted' in resource.data) || resource.data.isRestricted == false)) ||
                     (isAuthenticated() &&
                      (resource.data.contributorId == request.auth.uid || isReviewerOrHigher()));
      allow create: if isAuthenticated() && request.resource.data.contributorId == request.auth.uid;
      allow update: if isReviewerOrHigher();
      allow delete: if isAdminOrDirector();

      match /raw/{versionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/contributions/$(contributionId)).data.contributorId == request.auth.uid ||
          isReviewerOrHigher()
        );
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/contributions/$(contributionId)).data.contributorId == request.auth.uid;
        allow update, delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/contributions/$(contributionId)).data.contributorId == request.auth.uid ||
          isReviewerOrHigher()
        );
        allow create: if isReviewerOrHigher() && request.resource.data.reviewerUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /verified/{versionId} {
        allow read: if true;
        allow create, update: if isSeniorLinguistOrDirector();
        allow delete: if isAdminOrDirector();
      }

      match /derived/{derivedId} {
        allow read: if true;
        allow create, update: if isReviewerOrHigher() || isAdminOrDirector();
        allow delete: if isAdminOrDirector();
      }
    }

    match /dictionary_entries/{entryId} {
      // Only published/verified lexical entries are public.
      allow read: if resource.data.status == 'verified' || isAdminOrDirector();
      // Administrators and the project director curate the public dictionary.
      allow create: if isAdminOrDirector() &&
        request.resource.data.status in ['pending_review', 'verified'];
      allow update: if isAdminOrDirector() &&
        request.resource.data.status in ['pending_review', 'verified'];
      allow delete: if isAdminOrDirector();
    }

    match /recordings/{recordingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isReviewerOrHigher();
      allow delete: if isAdminOrDirector();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated() &&
        (resource.data.recipientUid == request.auth.uid || isAdminOrDirector());
      allow create, update, delete: if isAdminOrDirector();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdminOrDirector();
    }

    match /settings/{configKey} {
      allow read: if true;
      allow write: if isAdminOrDirector() || isSeniorLinguistOrDirector();
    }

    match /dataset_releases/{releaseId} {
      allow read: if resource.data.status in ['published', 'archived'] ||
        (isAuthenticated() && isReviewerOrHigher());
      allow create: if isAuthenticated() && isAdminOrDirector();
      allow update: if isAuthenticated() && isAdminOrDirector() &&
        (resource.data.status != 'published' ||
         (request.resource.data.status == 'archived' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archivedAt'])));
      allow delete: if false;

      match /records/{contributionId} {
        allow read: if get(/databases/$(database)/documents/dataset_releases/$(releaseId)).data.status in ['published', 'archived'] ||
          (isAuthenticated() && isReviewerOrHigher());
        allow create: if isAuthenticated() && isAdminOrDirector();
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if isAuthenticated() && isReviewerOrHigher();
        allow create: if isAuthenticated() && isReviewerOrHigher();
        allow update, delete: if false;
      }
    }

    match /derived_datasets/{datasetId} {
      allow read: if resource.data.status == 'published' ||
        (isAuthenticated() && isSeniorLinguistOrDirector());
      allow create: if isAuthenticated() && isLinguistAdminOrDirector();
      allow update: if isAuthenticated() && (
        (isAdminOrDirector() &&
         (resource.data.status != 'published' ||
          (request.resource.data.status == 'archived' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archivedAt'])))) ||
        (isSeniorLinguistOrDirector() && resource.data.status in ['draft', 'processing'] &&
         request.resource.data.status == 'validated')
      );
      allow delete: if false;

      match /records/{recordId} {
        allow read: if get(/databases/$(database)/documents/derived_datasets/$(datasetId)).data.status == 'published' ||
          (isAuthenticated() && isSeniorLinguistOrDirector());
        allow create: if isAuthenticated() && isLinguistAdminOrDirector();
        allow update, delete: if false;
      }
    }

    match /translations/{translationId} {
      allow read: if resource.data.status == 'verified' ||
        (isAuthenticated() &&
         (resource.data.translatorUid == request.auth.uid || isReviewerOrHigher()));
      allow create: if isAuthenticated() &&
        (request.resource.data.status != 'verified' || isSeniorLinguistOrDirector());
      allow update: if isAuthenticated() && (
        (request.resource.data.status == 'verified' && isSeniorLinguistOrDirector()) ||
        (resource.data.status != 'verified' &&
         (resource.data.translatorUid == request.auth.uid || isReviewerOrHigher()) &&
         request.resource.data.status != 'verified') ||
        isAdminOrDirector()
      );
      allow delete: if isAdminOrDirector() && resource.data.status != 'verified';

      match /machineSuggestions/{suggestionId} {
        allow read, create: if isAuthenticated();
        allow update: if isAuthenticated() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'suggestedText', 'modelProvider', 'modelName', 'targetLanguage', 'createdAt'
          ]);
        allow delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isReviewerOrHigher();
        allow update, delete: if false;
      }
    }
  }
}
